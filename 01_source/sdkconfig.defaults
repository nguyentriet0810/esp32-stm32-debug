# ESP32-S3-WROOM-1-N16R8: 16 MB Quad SPI flash and 8 MB Octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# Allocate large capture buffers explicitly with MALLOC_CAP_SPIRAM.
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_FREERTOS_UNICORE is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# UART0 console, with boot diagnostics also available over native USB Serial/JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Core 1 may remain busy during target programming; other watchdogs stay enabled.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_MAX_SOCKETS=10

# GPIO assignments from the custom PCB schematic, revision C.
CONFIG_PROBE_BOARD_PCB_REV_C=y
CONFIG_PROBE_SWDIO_GPIO=4
CONFIG_PROBE_SWCLK_GPIO=5
CONFIG_PROBE_NRST_GPIO=7
CONFIG_PROBE_SWO_GPIO=6
CONFIG_PROBE_OLED_ENABLE=y
CONFIG_PROBE_OLED_SDA_GPIO=8
CONFIG_PROBE_OLED_SCL_GPIO=9
CONFIG_PROBE_ENCODER_ENABLE=y
CONFIG_PROBE_ENCODER_A_GPIO=15
CONFIG_PROBE_ENCODER_B_GPIO=16
CONFIG_PROBE_ENCODER_SW_GPIO=17
CONFIG_PROBE_SD_ENABLE=y
CONFIG_PROBE_SD_CS_GPIO=38
CONFIG_PROBE_SD_MOSI_GPIO=39
CONFIG_PROBE_SD_SCK_GPIO=40
CONFIG_PROBE_SD_MISO_GPIO=41
CONFIG_PROBE_SD_DETECT_GPIO=42
CONFIG_PROBE_SD_MAX_FREQ_KHZ=4000
